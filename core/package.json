{
	"name": "@worldcoin/agentkit-core",
	"version": "0.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/worldcoin/agentkit.git",
		"directory": "core"
	},
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.mts",
				"default": "./dist/esm/index.mjs"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup"
	},
	"dependencies": {
		"@noble/curves": "^1.9.1",
		"@scure/base": "^1.2.6",
		"siwe": "^2.3.2",
		"viem": "^2.46.2",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
