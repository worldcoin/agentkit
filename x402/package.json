	},
	"scripts": {
		"build": "tsup"
	},
	"dependencies": {
		"@worldcoin/agentkit-core": "workspace:^",
		"@x402/core": "^2.4.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"tsup": "^8.5.1",
		"tweetnacl": "^1.0.3",
		"typescript": "^5.9.3"
	}
}
